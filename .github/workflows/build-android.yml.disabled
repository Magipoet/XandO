name: Build Android Release APK

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

env:
  FLUTTER_VERSION: '3.41.9'
  JAVA_VERSION: '17'
  APP_NAME: 'tictactoe-game'

permissions:
  contents: write

jobs:
  build-android:
    name: Build Android Release APK
    runs-on: ubuntu-latest
    timeout-minutes: 40
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v6
    
    - name: Setup Java JDK
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: ${{ env.JAVA_VERSION }}
    
    - name: Setup Android SDK
      uses: android-actions/setup-android@v3
    
    - name: Setup Flutter
      uses: subosito/flutter-action@v2
      with:
        flutter-version: ${{ env.FLUTTER_VERSION }}
        channel: 'stable'
        cache: true
    
    - name: Install dependencies
      run: flutter pub get
      timeout-minutes: 10
    
    - name: Generate Android platform files
      run: flutter create . --platforms android
      timeout-minutes: 5
    
    - name: Decode Keystore from Secrets
      env:
        KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
      run: |
        echo "$KEYSTORE_BASE64" | base64 -d > android/app/tictactoe-keystore.jks
        
        if [ -f android/app/tictactoe-keystore.jks ]; then
          echo "✅ Keystore file created successfully"
          ls -la android/app/tictactoe-keystore.jks
        else
          echo "❌ Failed to create keystore file"
          exit 1
        fi
    
    - name: Create key.properties
      env:
        STORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
        KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
      run: |
        cat > android/key.properties << EOF
        storePassword=$STORE_PASSWORD
        keyPassword=$KEY_PASSWORD
        keyAlias=$KEY_ALIAS
        storeFile=tictactoe-keystore.jks
        EOF
        
        echo "✅ key.properties created"
        cat android/key.properties | sed 's/=.*/=***REDACTED***/'
    
    - name: Update build.gradle for signing
      run: |
        BUILD_GRADLE="android/app/build.gradle"
        
        echo "📄 Original build.gradle (before signing config):"
        grep -A 20 "android {" $BUILD_GRADLE
        
        cp $BUILD_GRADLE ${BUILD_GRADLE}.bak
        
        cat > /tmp/signing_config.txt << 'SIGNING_EOF'

def keystoreProperties = new Properties()
def keystorePropertiesFile = rootProject.file('key.properties')
if (keystorePropertiesFile.exists()) {
    keystoreProperties.load(new FileInputStream(keystorePropertiesFile))
}

android {
    signingConfigs {
        release {
            keyAlias keystoreProperties['keyAlias']
            keyPassword keystoreProperties['keyPassword']
            storeFile keystoreProperties['storeFile'] ? file(keystoreProperties['storeFile']) : null
            storePassword keystoreProperties['storePassword']
        }
    }
SIGNING_EOF
        
        sed -i '/^android {$/d' $BUILD_GRADLE
        sed -i '/^def keystoreProperties = new Properties()$/,/^}$/d' $BUILD_GRADLE 2>/dev/null || true
        
        sed -i '/apply plugin: .*com.android.application/r /tmp/signing_config.txt' $BUILD_GRADLE
        
        sed -i 's/signingConfig signingConfigs.debug/signingConfig signingConfigs.release/g' $BUILD_GRADLE
        
        echo "✅ Updated build.gradle with signing config"
        echo ""
        echo "📄 Updated build.gradle signing section:"
        grep -A 30 "signingConfigs" $BUILD_GRADLE || echo "Note: Could not find signingConfigs in output"
    
    - name: Build Release APK
      run: |
        echo "🔨 Building Release APK..."
        flutter build apk --release
      timeout-minutes: 20
    
    - name: List build outputs
      run: |
        echo "📦 Build outputs:"
        ls -la build/app/outputs/flutter-apk/
        
        if [ -f build/app/outputs/flutter-apk/app-release.apk ]; then
          echo "✅ Release APK found"
        else
          echo "❌ Release APK not found"
          find build -name "*.apk"
          exit 1
        fi
    
    - name: Rename APK with version
      env:
        VERSION: ${{ github.ref_name }}
      run: |
        APK_VERSION=${VERSION:-dev}
        
        cp build/app/outputs/flutter-apk/app-release.apk \
          ${{ env.APP_NAME }}-android-$APK_VERSION-release.apk
        
        echo "✅ APK renamed to: ${{ env.APP_NAME }}-android-$APK_VERSION-release.apk"
        ls -la *.apk
    
    - name: Upload APK as Artifact
      uses: actions/upload-artifact@v7
      with:
        name: ${{ env.APP_NAME }}-Android-Release-APK
        path: ${{ env.APP_NAME }}-android-*.apk
        retention-days: 90
    
    - name: Upload APK to GitHub Release
      if: startsWith(github.ref, 'refs/tags/')
      uses: softprops/action-gh-release@v2
      with:
        files: |
          ${{ env.APP_NAME }}-android-*.apk
        generate_release_notes: false
        append_body: true
        token: ${{ secrets.GITHUB_TOKEN }}
